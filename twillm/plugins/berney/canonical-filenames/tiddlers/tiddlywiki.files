				"type": "text/vnd.tiddlywiki"
			}
		},
		{
			"file": "filter-titles.md",
			"fields": {
				"title": "$:/plugins/berney/canonical-filenames/filter-titles",
				"type": "text/markdown"
			}
		},
		{
			"file": "KW_ $_config_OriginalTiddlerPaths.md",
			"fields": {
				"title": "KW: $:/config/OriginalTiddlerPaths",
				"type": "text/markdown",
				"tags": [ "Concept", "Architecture" ],
